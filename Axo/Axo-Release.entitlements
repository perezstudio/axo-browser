<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release builds only: Axo.entitlements plus iCloud, for syncing Spaces, folders, and
	     pinned tabs (AxoSync). Signing with iCloud needs a provisioning profile, so Debug builds
	     and test runs use Axo.entitlements and don't sync. Keep the two files' other keys the
	     same. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- The rest of Chrome's app entitlements (chrome/app/app-entitlements.plist), for the
	     Chromium engine running in Axo's process: Web Bluetooth, WebUSB and WebHID, printing,
	     and the Photos library in file pickers. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.security.device.print</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.perezstudio.Axo</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Push notifications tell the sync engine when another device changed something. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
</dict>
</plist>
